pub struct Point { f32 x; f32 y; }
struct Plain { u8 a; }
static u32 counter = 0;
u32 add(u32 a, u32 b) { return a + b; }
extern("C") void free(rawptr p);
pub extern[c] aSymbol;
pub typedef Id = u32;
pub distinct Handle = rawptr;
const usize MAX = 8;
u32 glob = 3;
pub void(i32) handle(i32 sig, SigHandler* handler);
